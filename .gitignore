# number and period) but always for the account "SAMPLE-PI-...", never digits.
!fixtures/sample_household/imports/*_transactions_accSAMPLE-*.csv
*.ofx
*.qif
# Backups (always encrypted, but still never in git).
backups/
*.restic
*.age

