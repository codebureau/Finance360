data/
.data/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
# Known export file patterns from real providers (belt-and-braces; pre-commit guard also blocks).
*_transactions_*.csv
*transactions*acc[0-9]*.csv
