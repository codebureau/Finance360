# Copy to deploy/target.local.env (gitignored) and fill in. Placeholders only here: never commit
# real host names, IPs, users or paths. `deploy` refuses to run while any <placeholder> remains.

# How to reach the host: "ssh" (key-based, e.g. over an overlay VPN) or "local" (commands run on this machine
# in DEPLOY_REMOTE_DIR: for a throwaway test "host").
DEPLOY_TRANSPORT=ssh

# ssh only. user@name, where name is the host's network name (e.g. its overlay VPN name).
DEPLOY_SSH_TARGET=<ssh-user>@<host-name>
# Optional extra ssh options, e.g. -i <path-to-key>
# DEPLOY_SSH_OPTIONS=

# The host's git clone of Finance360 (docs/deploy.md, first-time setup).
DEPLOY_REMOTE_DIR=<path-of-the-clone-on-the-host>

# Where `deploy setup` clones the repo from, if DEPLOY_REMOTE_DIR does not exist yet.
# DEPLOY_REPO_URL=<repo-url>

# Optional: compose project name (default: the clone's folder name).
# DEPLOY_COMPOSE_PROJECT=finance360

# --- App settings: every FINANCE360_* line is written to the host's .env on each deploy ---------
# Port the app listens on inside the compose network (not published; ADR-0012).
FINANCE360_PORT=8000
# The one HTTPS port the host publishes (the Caddy proxy). `deploy setup` refuses if it is taken.
FINANCE360_HTTPS_PORT=8843
# Every name the household types, host[:port]: the LAN IP with the HTTPS port, plus (for mobile)
# the overlay VPN name, which `deploy setup --tailscale` adds. Anything else gets 421.
FINANCE360_ALLOWED_HOSTS=<lan-ip>:8843
# Backups (docs/backup-setup.md): host paths of the Backup key file and the rclone config folder.
FINANCE360_BACKUP_KEY_FILE=<host-path-of-the-backup-key-file>
FINANCE360_RCLONE_CONFIG_DIR=<host-path-of-the-rclone-config-folder>
FINANCE360_BACKUP_RCLONE_REMOTE=<rclone:remote:Folder>
# Prices and FX rates (docs/deploy.md): both OFF unless set; unset means no network use for data.
# FINANCE360_PRICE_PROVIDER=yfinance
# FINANCE360_FX_PROVIDER=rba
