# Copy to .env and adjust. Placeholders only: never commit real values or secrets.

# Directory holding this instance's data (SQLite file, documents). Each instance needs its own.
FINANCE360_DATA_DIR=./data

# Port this instance listens on. Each running instance needs its own.
FINANCE360_PORT=8000

# Build identifier shown by /health. "dev" when unset.
# GIT_SHA=

# --- Authentication (ADR-0010) --------------------------------------------------------------
# There is no default password and no switch that turns authentication off.
# First run: with none of the below set, read the one-off setup code from <data dir>/setup-code
# on the host and open the app to finish setup. Lost password: on the host, run
#   docker compose exec finance360 python -m finance360.auth reset

# Optional unattended install (test instances, the review slot): seeds the one Login at startup
# only if none exists, and never overwrites. 12 to 128 characters. The _FILE form is preferred
# (point it at a mounted secrets file); if both are set the file wins.
# FINANCE360_OWNER_PASSWORD_FILE=/run/secrets/finance360_owner_password
# FINANCE360_OWNER_PASSWORD=

# Active auth providers, comma separated (plugins/auth registry). Default: password.
# FINANCE360_AUTH_PROVIDERS=password

# Session cookie `Secure` flag. Leave on; set to false only for a plain-http host that needs it
# (browsers accept Secure cookies on http://localhost, so the review slot does not).
# FINANCE360_COOKIE_SECURE=true

# Names the app answers for, comma separated host[:port] (an entry without a port matches any
# port). Anything else gets 421; /health is exempt. The HTTPS proxy takes its certificates from the
# same list (ADR-0012). On the host: the LAN IP with the HTTPS port, and the overlay VPN name.
# FINANCE360_ALLOWED_HOSTS=localhost,127.0.0.1
# The one port the home host publishes (the Caddy proxy). Dev and the review slot don't use it.
# FINANCE360_HTTPS_PORT=8843

# --- Backups (ADR-0011) ----------------------------------------------------------------------
# Encrypted with restic before leaving the host. The key file holds the repo password (32+ random
# characters). Keep the key in the password manager, never in the repo.
# FINANCE360_BACKUP_KEY_FILE=/run/secrets/finance360_backup_key
# Local time of the nightly backup (HH:MM).
# FINANCE360_BACKUP_TIME=02:00
# Off-site restic repo via rclone, e.g. rclone:offsite:Finance360. Unset = local repo only.
# FINANCE360_BACKUP_RCLONE_REMOTE=rclone:offsite:Finance360
# Host directory holding rclone.conf (made once with `rclone config`); mounted writable.
# FINANCE360_RCLONE_CONFIG_DIR=/path/to/rclone-config

# --- Daily fetch of Prices and FX rates (ADR-0013 section 6) -----------------------------------
# OFF by default: with these unset the instance never touches the network for Prices or FX rates,
# and a first deploy with no network works. Set a key to switch that dataset on. Prices and rates
# you enter by hand always win over fetched ones for the same date.
# Price provider (unofficial Yahoo Finance, may break). Instruments need a `yahoo` identifier.
# FINANCE360_PRICE_PROVIDER=yfinance
# FX provider: the Reserve Bank of Australia's daily table, for currencies in use only.
# FINANCE360_FX_PROVIDER=rba
# Local time of the daily fetch (HH:MM, Household time zone). A catch-up also runs at start-up
# when the last success is over 24 hours old.
# FINANCE360_FETCH_TIME=18:30
# A Price older than this many days is shown as stale.
# FINANCE360_PRICE_STALE_DAYS=7
# `live` (default) reaches the real services. `sample` serves invented data with no network: for
# the review slot and demos only.
# FINANCE360_PROVIDER_TRANSPORT=live

# --- Ask and reading a page (ADR-0021, ADR-0023) ---------------------------------------------------
# Needs NOTHING to work. With no provider set, Ask searches the Guide on this server and shows the best
# passages with links ("Search only"), and "Read the page for me" on Rule figures finds figures by
# matching words on the page. Nothing is sent anywhere and nothing costs money.
# Set a provider only if you want Ask to also WRITE an answer from those passages (and a model to read
# the page): `anthropic` calls the Anthropic API, needs a key and is billed by Anthropic. Every
# question is redacted (names, account numbers, amounts) before it leaves the host, and the AI log
# shows exactly what was sent.
# FINANCE360_AI_PROVIDER=anthropic
# The key lives in a file on the host (preferred, mounted read-only), never in the repo.
# FINANCE360_AI_API_KEY_FILE=/path/to/ai-api-key
# FINANCE360_AI_API_KEY=
# Model for every AI task, and the Ask panel's own (cheaper) default.
# FINANCE360_AI_MODEL=claude-sonnet-5-5
# FINANCE360_AI_MODEL_ASK=claude-haiku-5-5
# Reading a Rule figure off a pasted page: Sonnet by default, not Haiku (a wrong figure costs most).
# FINANCE360_AI_MODEL_RULE_CAPTURE=claude-sonnet-5-5
# Spend cap per calendar month in US dollars (every AI task counts), and Ask questions per day
# (only Ask questions count). Calculated from the AI log.
# FINANCE360_AI_MONTHLY_CAP_USD=5.00
# FINANCE360_AI_DAILY_QUESTIONS=50
# Days the AI log is kept.
# FINANCE360_AI_LOG_DAYS=365
# Folder of the Guide's Markdown (the image sets it; from source it is frontend/src/guide).
# FINANCE360_GUIDE_DIR=
# CONTEXT.md, which Ask's search reads to know the app's terms (the image sets it; from source it
# is CONTEXT.md in the repo). If the file is missing, search still works without it.
# FINANCE360_CONTEXT_FILE=
